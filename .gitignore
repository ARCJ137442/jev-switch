# Jev-Switch 文档仓库 — gitignore

# 等 Rust 项目实装后再加 build artifacts
# target/
# node_modules/
# .venv/

# OS / 编辑器
.DS_Store
Thumbs.db
.vscode/
.idea/

# 密钥 / 本地配置（绝不进仓库）
.env
.env.local
*.key
*secret*

# 临时 / 本地产物
*.log
.tmp/

# Tauri 桌面壳（src-tauri 独立工程）构建产物与 sidecar 暂存二进制
src-tauri/target/
src-tauri/binaries/*.exe
src-tauri/gen/

# 本机 Tauri 验收截图可能包含脱敏密钥片段或演示数据，不进入公开仓库
docs/verification/tauri-user-evidence-2026-09-26/
# 旧设计/runtime 审计截图不是当前产品发布素材，留在本机供历史核对
docs/design/previews/runtime-audit/
docs/design/previews/v2/
# 本机 Claude Code 定时任务锁，不属于项目交付物
.claude/scheduled_tasks.lock
