{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Jev Switch",
  "mainBinaryName": "jev-switch",
  "version": "0.7.2",
  "identifier": "io.github.arcj137442.jevswitch",
  "build": {
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Jev Switch",
        "url": "index.html",
        "width": 412,
        "height": 732,
        "minWidth": 320,
        "minHeight": 480,
        "visible": true,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "icon": ["icons/icon.png"],
    "externalBin": []
  }
}
